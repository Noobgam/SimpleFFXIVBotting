{
    "Lua.runtime.version": "Lua 5.2",
    "Lua.workspace.library": [
        "${workspaceFolder}",
        "${workspaceFolder}/**/*",
        "${workspaceFolder}/.vscode/globals.lua",
        "${workspaceFolder}/.vscode/kitanoi_public.lua",
        "${workspaceFolder}/.vscode/class_quests.lua"
    ],
    "Lua.workspace.userThirdParty": [
        "${workspaceFolder}",
        "${workspaceFolder}/**/*",
        "${workspaceFolder}/.vscode/globals.lua",
        "${workspaceFolder}/.vscode/kitanoi_public.lua",
        "${workspaceFolder}/.vscode/class_quests.lua"
    ],
